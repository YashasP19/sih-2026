# Urban Lens Backend Environment Configuration

DEBUG=True
SECRET_KEY=django-insecure-urban-lens-sih-2026-super-secret-key-production-ready
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Engine: 'sqlite' or 'postgres'
DB_ENGINE=sqlite

# If PostgreSQL:
POSTGRES_DB=urban_lens_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
